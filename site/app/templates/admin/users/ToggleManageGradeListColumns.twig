{% extends 'generic/Popup.twig' %}
{% block popup_id %}toggle-columns-form{% endblock %}
{% block title %}Toggle Columns{% endblock %}
{% block body %}
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
    <p class="toggle-columns-instructions">
        Select which columns you would like to display.
    </p>
    <div class="toggle-columns-menu">
        <div class="toggle-checkbox-area">
            <input id="toggle-given-name" type="checkbox" class="toggle-columns-box" data-testid="toggle-given-name">
            <label for="toggle-given-name">Given Name</label>
        </div>
        <div class="toggle-checkbox-area">
            <input id="toggle-family-name" type="checkbox" class="toggle-columns-box" data-testid="toggle-family-name">
            <label for="toggle-family-name">Family Name</label>
        </div>
        <div class="toggle-checkbox-area">
            <input id="toggle-user-group" type="checkbox" class="toggle-columns-box" data-testid="toggle-user-group">
            <label for="toggle-user-group">User Group</label>
        </div>
        <div class="toggle-checkbox-area">   
            <input id="toggle-registration-sections" type="checkbox" class="toggle-columns-box" data-testid="toggle-registration-sections">
            <label for="toggle-registration-sections">Registration Sections</label>
        </div>
        <div class="toggle-checkbox-area">
            <input id="toggle-registration-subsection" type="checkbox" class="toggle-columns-box" data-testid="toggle-registration-subsection">
            <label for="toggle-registration-subsection">Registration Subsection</label>
        </div>
        <div class="toggle-checkbox-area">
            <input id="toggle-demote-grader" type="checkbox" class="toggle-columns-box" data-testid="toggle-demote-grader">
            <label for="toggle-demote-grader">Demote Grader</label>
        </div>
    </div>
    <div class="toggle-all-buttons">
        <a href="javascript:fillAllCheckboxes(true)" class="btn btn-primary">All On</a>
        <a href="javascript:fillAllCheckboxes(false)" class="btn btn-primary">All Off</a>
    </div>
{% endblock %}

{% block buttons %}
    {{ block('close_button') }}
    <input name="submit" class="btn btn-primary key_to_click" type="submit" value="Submit" onclick="updateManageGradersColumns()" data-testid="toggle-columns-submit"/>

{% endblock %}
