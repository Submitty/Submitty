<div id="peer_participation" class="rubric_panel" data-testid="peer-participation">
    <div class="draggable_content" style="width:100%">
        <div style="padding:20px; margin-top:10px;">
            <span class="col grading_label" style="padding-left:0;">Peer Participation</span>
            {% if participation is empty %}
                <p data-testid="peer-participation-empty">No peer grading participation found.</p>
            {% else %}
                {% for entry in participation %}
                    <div data-testid="peer-participation-entry" style="margin-top:15px;">
                        <strong>Student graded:</strong>
                        {% if entry.grade_url %}
                            <a data-testid="peer-participation-student-link" href="{{ entry.grade_url }}">{{ entry.display_id }}</a>
                        {% else %}
                            {{ entry.display_id }}
                        {% endif %}
                        <div style="margin-left:15px;">
                            <div><strong>Peer Component Grading</strong></div>
                            {% if entry.components is empty %}
                                <div data-testid="peer-participation-no-components"><em>No components graded</em></div>
                            {% endif %}
                            {% for component in entry.components %}
                                <div data-testid="peer-participation-component">
                                    <strong>{{ component.title }}:</strong>
                                    {% if component.score is null %}
                                        <em>No score</em>
                                    {% elseif component.max > 0 %}
                                        {{ component.score }} / {{ component.max }}
                                    {% else %}
                                        {{ component.score }}
                                    {% endif %}
                                </div>
                            {% endfor %}
                            <div data-testid="peer-participation-overall">
                                <strong>Overall comment:</strong>
                                {% if entry.overall_comment %}
                                    {{ entry.overall_comment }}
                                {% else %}
                                    <em>No overall comment</em>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>