{% extends "Component.twig" %}
{#
Required inputs:
    component: {id, title, ta_comment, student_comment, page, max_value}
    graded_component: {graders, marksassigned}
    peer_details: {
        graders,
        marks_assigned,
        graded_versions,
        version_conflicts
    }

    show_verify_grader = can_verify and grader_id is defined and grader_id != your_user_id
    {{ functions.getBadgeStyle(graded_component.total_score, component.max_value) }}
#}

{% set show_verify_grader = false %}

{% block header_block %}
    {% include 'PeerComponentHeader.twig' with {
        'peer_score': graded_gradeable.peer_scores[component.id],
    } %}
{% endblock %}

{% block content_block %}
{% endblock %}

{% block marks_block %}
{% endblock %}

{% block extra_mark_rows %}
{% endblock %}

{% block mark_list_footer %}
    {# Component is closed, so show just the received marks #}
    {% if not show_mark_list %}
        {% set conflictPresent = false %}
        {% for grader in peer_details.graders | sort %}
            {% if peer_details.version_conflicts[grader] %}
                {% if not conflictPresent %}
                    <div class="version-warning peer-version-warning" data-testid="peer-version-warning">
                        Version Conflict(s) Present
                    </div>
                    {% set conflictPresent = true %}
                {% endif %}
            {% endif %}
        {% endfor %}
        <div class="container">
            <div class="row divider"></div>
        </div>
        <div class="received-marks-list container">
            {# Points and Title stay pinned on the left; the columns for the peer graders scroll sideways #}
            <div class="peer-table-scroll" data-testid="peer-table-scroll">
                <table id="peer-grading-table" class="peer-marks-table">
                    <thead>
                        <tr>
                            <th class="peer-table-points"> Points </th>
                            <th class="peer-table-title"> Title </th>
                            {# Header row with the name of each grader #}
                            {% for grader in peer_details.graders | sort %}
                                <th class="peer-table-header{% if peer_details.version_conflicts[grader] %} peer-version-conflict peer-version-conflict-top{% endif %}" title="{{grader}}" data-testid="peer-grader-header" data-grader-id="{{grader}}">
                                    <span class="peer-table-name">{{grader}}</span>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% set last_mark = component.marks|last %}
                        {% for mark in component.marks %}
                            <tr>
                                <td class="peer-table-points">
                                    <span>{{ mark.points }}</span>
                                </td>
                                <td class="peer-table-title" data-testid="peer-mark-title">
                                    <span>{{ mark.title|nl2br }}</span>
                                </td>
                                {% for grader in peer_details.graders | sort %}
                                    <td class="peer-table-data{% if peer_details.version_conflicts[grader] %} peer-version-conflict{% if mark.id == last_mark.id %} peer-version-conflict-bottom{% endif %}{% endif %}" data-testid="peer-grader-mark" data-grader-id="{{grader}}">
                                        {% if mark.id in peer_details.marks_assigned[grader] %}
                                            <i class="far fa-check-square fa-1g" role="img" aria-label="{{grader}} selected this mark"></i>
                                        {% else %}
                                            <i class="far fa-square fa-1g" role="img" aria-label="{{grader}} did not select this mark"></i>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}