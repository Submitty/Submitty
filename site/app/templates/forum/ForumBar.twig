{% set user_group = core.getUser().getGroup() %}

{% if show_more is defined and show_more %}
	<script>
		$(document).ready(function() {
		    let filterOption = '{{ more_data[0]["filter_option"] }}';
		    if (filterOption) {
                $('#' + filterOption).parent().removeClass("active");
                $('#' + filterOption).addClass("active");
            }
		 });
	</script>
{% endif %}

<div class="forum-bar">
	<div class="toolbar">
		<div class="toolbar-left">
			{% if thread_exists %}
			<form id="forum-search-form" action="javascript:void(0);" data-ays-ignore="true">
				<input type='hidden' name="csrf_token" value="{{ csrf_token }}" />

				{% include "Vue.twig" with {
					'type': 'component',
					'name': 'forum/SearchBar',
					'args': { 'searchQuery': '' },
					'class': 'search-bar-wrapper',
					'events': {
						'search': '(query) => onSearchChange(query)'
					}
				} %}
				<div class="search-actions">
					{% for button in forum_bar_buttons_left %}
						{% if user_group <= button.required_rank %}
							{% set link = (button.link[0]) ? 'href=' ~ button.link[1] %}
							{% set onclick = (button.onclick[0]) ? 'onclick=' ~ button.onclick[1] %}
							{% if link | length > 0 %}
								<a class="btn btn-primary {{ button.optional_class }}" {{ link }} title="{{ button.title }}" {{ onclick }} role="button" >
									{{ button.display_text|raw }}
								</a>
							{% else %}
								<button type="button" class="btn btn-primary {{ button.optional_class }}" title="{{ button.title }}" {{ onclick }} >
									{{ button.display_text|raw }}
								</button>
							{% endif %}
						{% endif %}
					{% endfor %}
					<a id="clear_filter_button" class="btn btn-default" tabindex="0" title="Clear Filters" onclick="clearForumFilter();">&times; Clear Filters</a>
				</div>
			</form>
			{% endif %}
		</div>
		<div class="toolbar-right">
			{% include "Vue.twig" with {
				'type': 'component',
				'name': 'FullScreenButton',
				'events': { 'toggle': '(on) => { document.querySelector("main#main")?.classList.toggle("full-screen-mode", on); }' }
			} %}
			{% if show_more is defined and show_more %}
			{% set moreItems = [] %}
			{% if activeThread is not null %}
				{% set moreItems = moreItems|merge([{
						'id': 'mark-unread',
						'displayText': 'Unread Thread',
						'title': 'Mark Thread Unread'
					}]) %}
			{% endif %}
			{% if more_data is defined %}
				{% for more in more_data|slice(1) %}
					{% if user_group <= more.required_rank %}
						{% set moreItems = moreItems|merge([{
							'id': more.id,
							'displayText': more.display_text,
							'title': more.title,
							'link': more.link
						}]) %}
					{% endif %}
				{% endfor %}
			{% endif %}
			{% if core.getUser().accessGrading() and manage_categories_url is defined %}
				{% set moreItems = moreItems|merge([{
					'id': 'edit-categories',
					'displayText': 'Edit Categories',
					'title': 'Edit Forum Categories',
					'link': manage_categories_url
				}]) %}
			{% endif %}
			{% if thread_exists and (is_full_threads_page is not defined or not is_full_threads_page) %}
				{% set moreItems = moreItems|merge([{
						'id': 'toggle-attachments',
						'displayText': 'Show Attachments',
						'title': 'Click to toggle all post attachments',
						'badgeText': total_attachments is defined ? ''~total_attachments : ''
					}]) %}
				{% set currentDisplayOption = display_option is defined ? display_option : '' %}
				{% set moreItems = moreItems|merge([
					{ 'id': 'display-tree', 'displayText': 'Hierarchical Post Order', 'title': 'Sort posts by reply hierarchy' },
					{ 'id': 'display-time', 'displayText': 'Chronological Post Order (Asc)', 'title': 'Sort posts by ascending chronological order' },
					{ 'id': 'display-reverse-time', 'displayText': 'Chronological Post Order (Desc)', 'title': 'Sort posts by descending chronological order' }
				]) %}
				{% if user_group <= core.getUser().accessGrading() %}
					{% set moreItems = moreItems|merge([
						{ 'id': 'display-alpha', 'displayText': 'Alphabetical Post Order', 'title': "Sort posts by author's last name" },
						{ 'id': 'display-alpha_by_registration', 'displayText': 'Alpha by Registration Post Order', 'title': 'Sort posts by author registration section then last name' },
						{ 'id': 'display-alpha_by_rotating', 'displayText': 'Alpha by Rotating Post Order', 'title': 'Sort posts by author rotating section then last name' }
					]) %}
				{% endif %}
			{% endif %}
			{% include "Vue.twig" with {
				'type': 'component',
				'name': 'DropdownButton',
				'args': {
					'label': 'More',
					'items': moreItems
				},
				'events': {
					'select': 'forumHandleMoreDropdownSelect',
					'navigate': '(url) => { window.location.href = url; }'
				}
			} %}
			{% endif %}
		</div>
		<div>
			{% for button in forum_bar_buttons_right %}
				{% if user_group <= button.required_rank %}
					{% set link = (button.link[0]) ? 'href=' ~ button.link[1] %}
					{% set onclick = (button.onclick[0]) ? 'onclick=' ~ button.onclick[1] %}
					{% if link | length > 0 %}
							<a role="button" class="btn btn-primary {{ button.optional_class }} toolbar-right-btn" {{ link }} data-testid="{{ button.title }}" title="{{ button.title }}" {{ onclick }} >
								{{ button.display_text | raw }}
							</a>
					{% else %}
							<button type="button" class="btn btn-primary {{ button.optional_class }} toolbar-right-btn" data-testid="{{ button.title }}" title="{{ button.title }}" {{ onclick }} >
								{{ button.display_text | raw }}
							</button>
					{% endif %}
				{% endif %}
			{% endfor %}
		</div>
	</div>

	{% if thread_exists %}
		<style>
			{% for category in categories %}
				{{ "#categoryid_" ~ category.id }}.filter-inactive{
					color: {{ category.color }};
					border: 1px solid {{ category.color }}
				}

				{{ "#categoryid_" ~ category.id }}.filter-active{
					background-color: {{ category.color }}
				}

				[data-theme ="dark"] {{ "#categoryid_" ~ category.id }}.filter-inactive{
					color: white;
					border: 1px solid {{ category.color }}
				}

				[data-theme ="dark"] {{ "#categoryid_" ~ category.id }}.filter-active{
					background-color: {{ category.color }}
				}
			{% endfor %}
		</style>
		{% set forum_filter_categories = [] %}
		{% for category in categories %}
			{% set forum_filter_categories = forum_filter_categories | merge([{
				id: category.id,
				description: category.description,
				visibleDate: category.visibleDate is not null ? category.visibleDate|date('c') : null,
				diff: category.diff,
			}]) %}
		{% endfor %}
		{% include "Vue.twig" with {
			type: "component",
			name: "forum/ForumFilterBar",
			class: "js-filter-bar",
			args: {
				categories: forum_filter_categories,
				initialSelectedCategoryIds: cookie_selected_categories|default([]),
				initialSelectedThreadStatuses: cookie_selected_thread_status|default([]),
				initialUnreadChecked: cookie_selected_unread_value|default(false) == 'true',
			},
			events: {
				'filter-change': '(state) => onFilterChange(state)',
			}
		} only %}
	{% endif %}
</div>
<hr/>
{% if thread_exists and show_filter %}
<script>
	var forumFilterCategories = {{ forum_filter_categories|json_encode()|raw() }};

	function updateThreads(loadFirstPage, success_callback) {
		{% if thread_exists %}
		modifyThreadList({{ current_thread }}, '{{ current_category_ids|join("|") }}', '{{ current_course }}', loadFirstPage, success_callback);
		{% endif %}
	}

	$( document ).ready(function() {
		seedFilterState(
			{{ cookie_selected_categories|default([])|json_encode()|raw() }},
			{{ cookie_selected_thread_status|default([])|json_encode()|raw() }},
			{{ cookie_selected_unread_value|default(false) == 'true' }}
		);
		updateThreads(true, null);
		saveFilterState();

		$('#num_filtered').text({{ display_thread_count }});

		updateClearFilterButton();

		window.onpopstate = function (e) {
			setFilterState(e.state);
		};

		{% if display_option is defined and display_option in ['tree', 'time', 'alpha'] %}
			$("#{{display_option }}_label").addClass('active');
		{% endif %}

		window.csrfToken = "{{ csrf_token }}" ;
	});
</script>
{% endif %}
