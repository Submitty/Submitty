<div class="content forum_content">
    {% include "forum/ForumBar.twig" with {
        "forum_bar_buttons_right" : forumBarData.forum_bar_buttons_right,
        "forum_bar_buttons_left" : forumBarData.forum_bar_buttons_left,
        "show_threads" : forumBarData.show_threads,
        "thread_exists" : forumBarData.thread_exists,
        "categories": [],
        "show_filter": false,
        "show_more": false,
        "csrf_token": csrf_token,
        "activeThread": null
    } %}
    <div class="stats-table-container">
        {% set id = uniqid() %}
        <table class="table table-striped table-bordered persist-area" id="vue-{{ id }}">
        </table>
        <script>
            window.submitty.render(
                "#vue-{{ id }}",
                "component",
                "forum/ForumStatsTable",
                {{ { users: userData } | json_encode() | raw() }},
                {
                    'navigate-to-thread': '(payload) => { window.open(buildCourseUrl(["forum", "threads", payload.threadId]), "_blank"); }'
                }
            );
        </script>
    </div>
</div>
