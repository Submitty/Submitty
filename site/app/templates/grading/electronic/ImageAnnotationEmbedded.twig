<div id="image-content-wrapper">
    <div id="image-viewer" class="imageViewer">
        <div id="image-error-message" style="display: none; color: red; font-weight: bold; padding: 10px; text-align: center;"></div>
        {#
            TODO: introduce image annotation to peer grading?
            Previously peer graders could leave annotations, but they would never see annotations
            received by other peers because PeerResults.twig doesn't display them.
            (Will also require changes to AutoGradingView.php.)

            See Issue #13122, https://github.com/Submitty/Submitty/issues/13122
        #}
        {% if can_annotate %}
            <div class="image-annotation-container">
                <div class="annotation-toolbar">
                    <button id="add-annotations-btn" class="btn btn-primary" title="Add annotations" onclick="if (typeof addAnnotations === 'function') addAnnotations();">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button id="save-annotations-btn" class="btn btn-success" title="Save annotations" onclick="if (typeof saveAnnotations === 'function') saveAnnotations();">
                        <i class="fas fa-save"></i>
                    </button>
                    <button id="clear-annotations-btn" class="btn btn-warning" title="Clear annotations" onclick="if (typeof clearAnnotations === 'function') clearAnnotations();">
                        <i class="fas fa-eraser"></i>
                    </button>
                    
                    {% if can_download %}
                        <button id="download-image-btn" class="btn btn-secondary" title="Download image with annotations" onclick="if (typeof downloadImage === 'function') downloadImage();">
                            <i class="fas fa-download"></i>
                        </button>
                    {% endif %}
                <span id="annotation-status"></span>
            </div>
        {% endif %}

            <img id="annotatable-image" 
                src="{{ display_file_url }}?dir={{ directory }}&file={{ filename | url_encode }}&path={{ file_path | url_encode }}&ta_grading=true&gradeable_id={{ gradeable_id }}" 
                alt="{{ filename }}" />

        </div>
    </div>
</div>

<script defer>
    $(()=>{
        if({{ can_annotate ? "true" : "false" }}) {
            window.initImageAnnotation("{{ gradeable_id }}", "{{ user_id }}", "{{ grader_id }}", "{{ filename | e('js') }}", "{{ file_path | e('js') }}", "{{ csrfToken }}", {{ student_popup ? 'true' : 'false' }}, {{ annotation_jsons | json_encode | raw }});
        }
    })
</script>