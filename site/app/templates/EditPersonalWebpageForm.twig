{% extends 'generic/Popup.twig' %}
{% block popup_id %}edit-personal-webpage-form{% endblock %}
{% block title %}Edit Personal Webpage{% endblock %}
{% block body %}
    <p class="std-margin">The personal webpage you specify will be visible to all members of the teaching staff.</p>
    <p class="std-margin">Share personal projects and accomplishments with your instructors.</p>

    <div class="flex-col" id="user_settings_modal">
        <input id="user-webpage-csrf" type="hidden" name="csrf_token" value="{{ csrf_token }}" />
        <h2>My Personal Webpage</h2>
        <div class="edit_user_row ui-front">
            <label for="user-personal-webpage-change">Personal Webpage:&emsp;</label>
            <input type="text"
                   name="personal_webpage"
                   data-testid="personal-webpage-input"
                   value="{{ personal_webpage }}"
                   id="user-personal-webpage-change"
                   placeholder="Type"
                   size="30"
                   maxlength = "255"
                   >
            </input>
        </div>
        <br>
       
    </div>
{% endblock %}
{% block form %}
    <form method="post" onsubmit="return updateUserWebpage(event)">
        {{ parent() }}
    </form>
{% endblock %}
{% block buttons %}
    {{ block('close_button') }}
    <input class="btn btn-primary" type="submit" value="Submit" id="edit-webpage-submit" data-testid="edit-webpage-submit" />
{% endblock %}
