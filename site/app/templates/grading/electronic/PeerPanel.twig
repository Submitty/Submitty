<div id="peer_info" class="rubric_panel {{ is_ta_grading ? "" : "empty" }}" data-testid="peer-info">
    <div>
        {% if is_ta_grading %}
            <div id="rubric-container" class="container">
                <span class="col grading_label">Peer Grading
                    <span id="edit-peer-components-form"></span>
                    <script>
                        window.submitty.render(
                            "#edit-peer-components-form",
                            "component",
                            "ta_grading/EditPeerComponentsForm",
                            {{ { peers: peers, peerNames: peer_names, submitterId: submitter_id, gradeableId: gradeable_id, csrfToken: csrf_token, components: components, componentScores: component_scores, peerDetails: peer_details, marks: marks, activeVersion: active_version } | json_encode() | raw() }},
                            {{ { 'clear-marks': '(detail) => { clearPeerMarks(detail.submitterId, detail.gradeableId, detail.peer, detail.csrfToken); }', 'resolve-version-conflicts': '(detail) => { resolvePeerVersionConflicts(detail.submitterId, detail.gradeableId, detail.peer, detail.csrfToken); }', 'save-component': '(detail) => { savePeerComponent(detail.submitterId, detail.gradeableId, detail.peer, detail.componentId, detail.csrfToken); }', 'mark-change': '(detail) => { peerComponentMarksChanged(detail.peer, detail.componentId); }' } | json_encode() | raw() }}
                        );
                    </script>
                    {% if has_peer_version_conflict %}
                        <button type="button" class="btn" onclick="clearAllPeerVersionConflicts('{{submitter_id}}', '{{gradeable_id}}', '{{anon_id}}', '{{csrf_token}}')">
                            Clear All Peer Version Conflicts
                        </button>
                    {% endif %}
                </span>
                <div class="inner-container" id="peer-grading-box">
                    {% if has_active_version %}
                        <script>
                            $(document).ready(function () {
                                loadTemplates().then(function() {
                                    return reloadPeerRubric('{{ gradeable_id }}', '{{ anon_id }}');
                                });
                            });
                        </script>
                    {% else %}
                        <h4>No Submission</h4>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div id="no-manual-grading-container">
                <h3> No Manual Grading For This Assignment </h3>
            </div>
        {% endif %}
    </div>
</div>
