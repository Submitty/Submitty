<div id="peer_info" class="rubric_panel {{ is_ta_grading ? "" : "empty" }}" data-testid="peer-info">
    <div>
        {% if is_ta_grading %}
            <div id="rubric-container" class="container">
                <div class="col grading_label">Peer Grading
                    {% include 'Vue.twig' with {
                        'type': 'component',
                        'name': 'ta_grading/EditPeerComponentsForm',
                        'class': 'js-edit-peer-components-form',
                        'args': {
                            'peers': peers,
                            'peerNames': peer_names,
                            'submitterId': submitter_id,
                            'gradeableId': gradeable_id,
                            'components': components,
                            'componentScores': component_scores,
                            'peerDetails': peer_details,
                            'marks': marks,
                            'activeVersion': active_version,
                        },
                        'events': {
                            'toggle': 'toggleEditPeerComponentsForm',
                            'peer-change': 'onPeerChange',
                            'clear-marks': '(detail) => { clearPeerMarks(detail.submitterId, detail.gradeableId, detail.peer, window.csrfToken); }',
                            'resolve-version-conflicts': '(detail) => { resolvePeerVersionConflicts(detail.submitterId, detail.gradeableId, detail.peer, window.csrfToken); }',
                            'save-component': '(detail) => { savePeerComponent(detail.submitterId, detail.gradeableId, detail.peer, detail.componentId, window.csrfToken); }',
                            'mark-change': '(detail) => { peerComponentMarksChanged(detail.peer, detail.componentId); }',
                        },
                    } %}
                    <script>
                        window.peerEditFormData = {{ { peers: peers, peerNames: peer_names, submitterId: submitter_id, gradeableId: gradeable_id, components: components, componentScores: component_scores, peerDetails: peer_details, marks: marks, activeVersion: active_version } | json_encode() | raw() }};
                    </script>
                    {% if has_peer_version_conflict %}
                        <button type="button" class="btn" data-testid="clear-all-peer-version-conflicts-btn" onclick="clearAllPeerVersionConflicts('{{submitter_id}}', '{{gradeable_id}}', '{{anon_id}}', '{{csrf_token}}')">
                            Clear All Peer Version Conflicts
                        </button>
                    {% endif %}
                </div>
                <div class="inner-container" id="peer-grading-box">
                    {% if has_active_version %}
                        <script>
                            $(document).ready(function () {
                                loadTemplates().then(function() {
                                    return reloadPeerRubric('{{ gradeable_id }}', '{{ anon_id }}');
                                });
                            });
                        </script>
                    {% else %}
                        <h4>No Submission</h4>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div id="no-manual-grading-container">
                <h3> No Manual Grading For This Assignment </h3>
            </div>
        {% endif %}
    </div>
</div>
