<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="./tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache">
  <coverage>
    <report>
      <clover outputFile="tests/report/clover.xml"/>
      <html outputDirectory="tests/report"/>
    </report>
  </coverage>
  <testsuites>
    <testsuite name="Unit Tests">
      <directory suffix="Tester.php">./tests/app</directory>
    </testsuite>
    <testsuite name="phpstan extension">
      <directory suffix="Tester.php">./tests/phpstan</directory>
      <exclude>./tests/phpstan/DoctrineExtensionTester.php</exclude>
    </testsuite>
  </testsuites>
  <logging/>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
      <directory suffix=".php">./tests/phpstan</directory>
    </include>
    <exclude>
      <directory suffix=".php">./app/views</directory>
    </exclude>
  </source>
</phpunit>
